

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <include layout="@layout/view_header" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- REVIEW TRANSACTION -->

            <LinearLayout
                android:id="@+id/layoutReview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/Uneswa.Label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Please review your eWallet transfer" />

                <com.google.android.material.card.MaterialCardView
                    style="@style/Uneswa.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <!-- FROM -->

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingTop="6dp"
                            android:paddingBottom="6dp">

                            <TextView
                                style="@style/Uneswa.RowLabel"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="From" />

                            <TextView
                                android:id="@+id/tvFrom"
                                style="@style/Uneswa.RowValue"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1.4" />
                        </LinearLayout>

                        <!-- TO -->

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingTop="6dp"
                            android:paddingBottom="6dp">

                            <TextView
                                style="@style/Uneswa.RowLabel"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="To" />

                            <TextView
                                android:id="@+id/tvTo"
                                style="@style/Uneswa.RowValue"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1.4" />
                        </LinearLayout>


                        <!-- CUSTOMER NAME -->

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="top"
                            android:paddingTop="6dp"
                            android:paddingBottom="6dp">

                            <TextView
                                style="@style/Uneswa.RowLabel"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Customer name" />

                            <TextView
                                android:id="@+id/tvCustomerName"
                                style="@style/Uneswa.RowValue"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1.4"
                                android:gravity="end" />

                        </LinearLayout>

                        <!-- AMOUNT -->

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingTop="6dp"
                            android:paddingBottom="6dp">

                            <TextView
                                style="@style/Uneswa.RowLabel"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Amount" />

                            <TextView
                                android:id="@+id/tvAmount"
                                style="@style/Uneswa.RowValue"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1.4" />
                        </LinearLayout>

                        <!-- BALANCE AFTER -->

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingTop="6dp"
                            android:paddingBottom="6dp">

                            <TextView
                                style="@style/Uneswa.RowLabel"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Balance after" />

                            <TextView
                                android:id="@+id/tvBalanceAfter"
                                style="@style/Uneswa.RowValue"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1.4" />
                        </LinearLayout>

                        <!-- RECIPIENT / PIN INFORMATION -->

                        <!-- RECIPIENT TYPE AND IDENTITY -->

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="top"
                            android:paddingTop="6dp"
                            android:paddingBottom="6dp">

                            <TextView
                                style="@style/Uneswa.RowLabel"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="0.8"
                                android:text="Recipient type" />

                            <TextView
                                android:id="@+id/tvPinSent"
                                style="@style/Uneswa.RowValue"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1.6"
                                android:gravity="end"
                                android:lineSpacingExtra="2dp" />

                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Please verify the recipient and amount before confirming."
                    android:textColor="@color/uneswa_ink"
                    android:textSize="13sp" />

            </LinearLayout>

            <!-- SUCCESS STATE -->

            <LinearLayout
                android:id="@+id/layoutSuccess"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Transaction successful"
                    android:textColor="@color/uneswa_green"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSuccessSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/uneswa_ink"
                    android:textSize="15sp" />

                <com.google.android.material.card.MaterialCardView
                    style="@style/Uneswa.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <!-- TRANSACTION REFERENCE / VOUCHER CODE -->

                        <TextView
                            android:id="@+id/tvResultCodeLabel"
                            style="@style/Uneswa.RowLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Voucher code" />

                        <TextView
                            android:id="@+id/tvVoucherCode"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textColor="@color/uneswa_blue_dark"
                            android:textIsSelectable="true"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <!-- RECIPIENT / SMS DETAILS -->

                        <TextView
                            android:id="@+id/tvSmsLabel"
                            style="@style/Uneswa.RowLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="Message to recipient (simulated SMS)" />

                        <TextView
                            android:id="@+id/tvSms"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textColor="@color/uneswa_ink"
                            android:textSize="15sp"
                            android:textIsSelectable="true" />

                        <!-- UPDATED BANK BALANCE -->

                        <TextView
                            style="@style/Uneswa.RowLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="New bank balance" />

                        <TextView
                            android:id="@+id/tvNewBalance"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textColor="@color/uneswa_ink"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- ERROR -->

            <TextView
                android:id="@+id/tvError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/uneswa_red"
                android:textSize="14sp"
                android:visibility="gone" />

            <!-- LOADING -->

            <ProgressBar
                android:id="@+id/progress"
                style="?android:attr/progressBarStyle"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:indeterminateTint="@color/uneswa_blue"
                android:visibility="gone" />

        </LinearLayout>

    </ScrollView>

    <!-- CONFIRM / DONE BUTTON -->

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnConfirm"
        style="@style/Uneswa.Button"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_margin="20dp"
        android:text="Confirm Payment" />

</LinearLayout>
