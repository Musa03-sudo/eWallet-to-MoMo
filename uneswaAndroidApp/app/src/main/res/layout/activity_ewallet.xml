
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <include layout="@layout/view_header" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Sender account -->
            <TextView
                style="@style/Uneswa.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="From" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Uneswa.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvFromName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/uneswa_ink"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvFromBalance"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/uneswa_grey"
                        android:textSize="14sp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Recipient cellphone -->
            <TextView
                style="@style/Uneswa.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="To (recipient cellphone)" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Uneswa.Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:counterEnabled="true"
                app:counterMaxLength="11"
                app:helperText="Enter 11 digits: 3-digit code + 8-digit number">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etRecipient"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="e.g. 26876100002"
                    android:imeOptions="actionNext"
                    android:inputType="number"
                    android:digits="0123456789"
                    android:maxLength="11"
                    android:maxLines="1"
                    android:textColor="@color/uneswa_ink" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Amount -->
            <TextView
                style="@style/Uneswa.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Amount" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Uneswa.Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etAmount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="0.00"
                    android:imeOptions="actionDone"
                    android:inputType="numberDecimal"
                    android:maxLines="1"
                    android:textColor="@color/uneswa_ink" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Error message -->
            <TextView
                android:id="@+id/tvError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/uneswa_red"
                android:textSize="14sp"
                android:visibility="gone" />

            <!-- Loading indicator -->
            <ProgressBar
                android:id="@+id/progress"
                style="?android:attr/progressBarStyle"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:indeterminateTint="@color/uneswa_blue"
                android:visibility="gone" />

        </LinearLayout>

    </ScrollView>

    <!-- Send button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSend"
        style="@style/Uneswa.Button"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_margin="20dp"
        android:text="Send" />

</LinearLayout>
