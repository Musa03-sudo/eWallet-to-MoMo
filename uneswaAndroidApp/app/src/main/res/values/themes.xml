<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.UneswaBank" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/uneswa_blue_dark</item>
        <item name="colorPrimaryVariant">@color/uneswa_blue_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/uneswa_yellow</item>
        <item name="colorOnSecondary">@color/uneswa_ink</item>
        <item name="android:statusBarColor">@color/white</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@color/white</item>
    </style>

    <!-- Shared styles used by the screens after login -->
    <style name="Uneswa.Input" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxStrokeColor">@color/uneswa_blue</item>
        <item name="hintTextColor">@color/uneswa_blue_dark</item>
    </style>

    <style name="Uneswa.Button" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/uneswa_blue_dark</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Uneswa.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">2dp</item>
        <item name="cardBackgroundColor">@color/white</item>
        <item name="strokeColor">@color/uneswa_blue</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Uneswa.Tile" parent="Uneswa.Card">
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="Uneswa.Label" parent="">
        <item name="android:textColor">@color/uneswa_ink</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Uneswa.RowLabel" parent="">
        <item name="android:textColor">@color/uneswa_grey</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Uneswa.RowValue" parent="">
        <item name="android:textColor">@color/uneswa_ink</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:gravity">end</item>
    </style>
</resources>